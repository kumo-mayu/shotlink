<Project Sdk="Microsoft.NET.Sdk">

  <!--
    通知領域のアイコンと設定の窓。メインウィンドウは持たない（仕様書 2章）。
    Windows Forms だけで作る。WPF を外すと exe が 191 MB から 137 MB になる（仕様書 8章 [決定]）
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- トースト通知と画像の読み込み（Windows.UI.Notifications・Windows.Graphics.Imaging）のため、Windows 10 1809 以降の API を参照する -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ShotLink</AssemblyName>
    <RootNamespace>ShotLink.App</RootNamespace>
    <ApplicationIcon>ShotLink.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShotLink.Core\ShotLink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      通知はトースト。NotifyIcon の吹き出しは、Windows 11 では通知センターに残らず、一度に1件しか出せない
      （2026-10-14 に実機で確かめた）。この部品は、インストーラーの無いアプリでもクリックを受け取れるよう登録してくれる
    -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 設定の窓の「第三者のライセンス」で見せる。単一ファイルの exe だけを取り出されても読めるよう、中に入れる -->
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

</Project>
