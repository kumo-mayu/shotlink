<Project Sdk="Microsoft.NET.Sdk">

  <!--
    通知領域のアイコンと設定の窓。メインウィンドウは持たない（仕様書 2章）。
    WPF に通知領域の部品が無いので、アイコンは Windows Forms の NotifyIcon を使う（仕様書 8章）
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- トースト通知（Windows.UI.Notifications）を使うため、Windows 10 1809 以降の API を参照する -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ShotLink</AssemblyName>
    <RootNamespace>ShotLink.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShotLink.Core\ShotLink.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      通知はトースト。NotifyIcon の吹き出しは、Windows 11 では通知センターに残らず、一度に1件しか出せない
      （2026-10-14 に実機で確かめた）。この部品は、インストーラーの無いアプリでもクリックを受け取れるよう登録してくれる
    -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

</Project>
