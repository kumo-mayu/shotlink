<?xml version="1.0" encoding="utf-8"?>
<!--
  配る形（仕様書 8章 [決定]）：.NET を同梱した単一ファイル。dotnet publish ShotLink.App -p:PublishProfile=win-x64
  csproj ではなくここに書くのは、RuntimeIdentifier を csproj に書くと dotnet build まで RID 付きになり、
  開発用の exe の場所が変わるため（Chmonos と同じ判断）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- zxing-cpp のネイティブの DLL も exe の中に入れ、exe 1つで動くようにする -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 圧縮すると zip はほぼ同じ大きさなのに、常駐のメモリが 3 倍になる（仕様書 8章） -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- トリミングはしない（仕様書 8章 [決定]。Windows Forms は公式に対応していない） -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>..\publish\ShotLink-win-x64\</PublishDir>
  </PropertyGroup>
</Project>
